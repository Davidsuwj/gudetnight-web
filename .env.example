# Copy the values you need into your shell environment or a private .env file.
# This project intentionally does not auto-load or commit real credentials.

# Windows/WSL paths
GUDETNIGHT_WINDOWS_PROJECT_DIR=C:\\path\\to\\gudetnight_web
GUDETNIGHT_WORKSPACE=C:\\path\\to\\workspace
GUDETNIGHT_DOWNLOADS_DIR=C:\\path\\to\\workspace\\Downloads
GUDETNIGHT_SCREENSHOT_DIR=C:\\path\\to\\workspace\\screenshots
GUDETNIGHT_LOGO_PATH=C:\\path\\to\\workspace\\logo.jpg
GUDETNIGHT_PROMPT_FILE=C:\\path\\to\\workspace\\podcast_spec.txt
GUDETNIGHT_JSON_OUTPUT=C:\\path\\to\\workspace\\podcast_output.json
FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe

# Visible Chrome launched with a dedicated --user-data-dir
GUDETNIGHT_CDP_URL=http://[::1]:9222

# YouTube Studio metadata. Login state remains only in the local Chrome profile.
YOUTUBE_ACCOUNT_EMAIL=your-channel-account@example.com
YOUTUBE_CHANNEL_ID=UC_REPLACE_WITH_YOUR_CHANNEL_ID
GUDETNIGHT_YOUTUBE_UPLOADER=C:\\path\\to\\youtube_uploader.py

# Required Amazon Associates disclosure for affiliate recommendations.
AMAZON_ASSOCIATES_DISCLOSURE=As an Amazon Associate I earn from qualifying purchases.

# Optional WSL launcher overrides
GUDETNIGHT_PYTHON=python3
GUDETNIGHT_FRONTEND_LOG=/tmp/gudetnight-frontend.log
